{
	debug
	admin localhost:2019
	auto_https off

	layer4 {
		:15432 {
			route {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
		}
		:15433 {
			route {
				proxy localhost:5432
			}
		}
		:15434 {
			route {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
		}
	}
}

# Trigger internal certificate issuance for localhost.
# The layer4 TLS handler will reuse this cert via the global TLS app.
https://localhost:9443 {
	tls internal {
		on_demand
	}
	respond "OK"
}
