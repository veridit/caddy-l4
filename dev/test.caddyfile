{
	debug
	admin localhost:2019
	auto_https disable_redirects

	# Global listener_wrappers to intercept PostgreSQL
	# TLS-terminated connections work on all ports
	# Cleartext connections only work if no TLS is present (port 8080)
	servers {
		listener_wrappers {
			layer4 {
				# Route 1: TLS-terminated postgres (for HTTPS servers on any port)
				@postgres_tls {
					tls
					postgres
				}
				route @postgres_tls {
					# TLS already terminated by HTTPS server
					proxy localhost:5432
				}

				# Route 2: Cleartext postgres (will match on port 8080, not on 9080/9443)
				@postgres_cleartext postgres
				route @postgres_cleartext {
					proxy localhost:5432
				}
			}
		}
	}

	layer4 {
		:15432 {
			route {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
		}
		:15433 {
			route {
				proxy localhost:5432
			}
		}
		:15434 {
			route {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
		}
		:15435 {
			@sni tls {
				sni local.statbus.org
			}
			route @sni {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
			route {
				tls {
					connection_policy {
						alpn postgresql
					}
				}
				proxy localhost:5432
			}
		}
	}
}

# HTTP server for cleartext PostgreSQL over HTTP (port 8080)
# The global listener_wrapper will intercept cleartext PostgreSQL connections.
:8080 {
	respond "OK"
}

# HTTPS server for TLS PostgreSQL (ports 9080 HTTP, 9443 HTTPS)
# Trigger internal certificate issuance for localhost and local.statbus.org.
# The layer4 TLS handler will reuse these certs via the global TLS app.
# Both HTTP (9080) and HTTPS (9443) ports, listener_wrapper blocks cleartext postgres.
localhost:9080, local.statbus.org:9080,
localhost:9443, local.statbus.org:9443 {
	tls internal {
		on_demand
		# Allow PostgreSQL ALPN alongside HTTPS protocols
		alpn postgresql h3 h2 http/1.1
	}

	respond "OK"
}
